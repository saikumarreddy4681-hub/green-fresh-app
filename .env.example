# Green Fresh App - Root Environment Template
# Copy this or set up backend/.env

# Port for the Express backend API
PORT=5000

# MongoDB Connection String:
# For Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/green_fresh_app
#
# For MongoDB Atlas (Recommended):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/green_fresh_app?retryWrites=true&w=majority

# JWT Secret for user & admin authentication tokens
JWT_SECRET=green_fresh_secret_key_2026_super_secure

# Allowed Client Origin (Vite default dev URL)
CLIENT_URL=http://localhost:5173

NODE_ENV=development

