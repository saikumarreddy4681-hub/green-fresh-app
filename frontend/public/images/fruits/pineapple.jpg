<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fffbeb" />
      <stop offset="100%" stop-color="#fef3c7" />
    </linearGradient>
    <filter id="softShadow" x="-10%" y="-10%" width="130%" height="130%">
      <feDropShadow dx="0" dy="12" stdDeviation="16" flood-color="#0f172a" flood-opacity="0.08" />
    </filter>
    <filter id="badgeShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#059669" flood-opacity="0.15" />
    </filter>
  </defs>

  <!-- Background Canvas -->
  <rect width="600" height="600" rx="36" fill="url(#bg)" />
  <rect x="20" y="20" width="560" height="560" rx="28" fill="none" stroke="#ffffff" stroke-width="2" stroke-opacity="0.8" />

  <!-- Soft Studio Platform -->
  <ellipse cx="300" cy="420" rx="190" ry="32" fill="#000000" fill-opacity="0.05" />
  <ellipse cx="300" cy="415" rx="140" ry="20" fill="#000000" fill-opacity="0.04" />

  <!-- Main Art Content -->
  <g transform="translate(0, -15)">
    
      <g transform="translate(190, 140)">
        <!-- Crown Leaves -->
        <path d="M110 110 L110 20 L95 70 L70 30 L85 90 L50 60 L75 110 Z" fill="#15803d"/>
        <path d="M110 110 L110 20 L125 70 L150 30 L135 90 L170 60 L145 110 Z" fill="#16a34a"/>
        <!-- Body -->
        <rect x="50" y="100" width="120" height="180" rx="55" fill="#d97706"/>
        <!-- Diamond Crosshatch -->
        <path d="M60 140 L160 220 M60 180 L160 260 M60 220 L140 280" stroke="#b45309" stroke-width="3"/>
        <path d="M160 140 L60 220 M160 180 L60 260 M160 220 L80 280" stroke="#b45309" stroke-width="3"/>
        <circle cx="110" cy="180" r="6" fill="#f59e0b"/>
      </g>
    
  </g>

  <!-- Top Category & Organic Badges -->
  <g transform="translate(40, 48)">
    <rect width="110" height="32" rx="16" fill="#ecfdf5" stroke="#a7f3d0" stroke-width="1.5" filter="url(#badgeShadow)" />
    <circle cx="20" cy="16" r="4.5" fill="#10b981" />
    <text x="32" y="21" font-family="system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="12" font-weight="700" fill="#065f46" letter-spacing="1">100% ORGANIC</text>
  </g>

  
  <g transform="translate(450, 48)">
    <rect width="110" height="32" rx="16" fill="#fef3c7" stroke="#fde68a" stroke-width="1.5" />
    <text x="55" y="21" text-anchor="middle" font-family="system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="12" font-weight="700" fill="#92400e">TROPICAL</text>
  </g>

  <!-- Bottom Details Bar -->
  <rect x="40" y="490" width="520" height="70" rx="20" fill="#ffffff" fill-opacity="0.95" filter="url(#softShadow)" />
  <text x="64" y="528" font-family="system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="22" font-weight="800" fill="#0f172a">Queen Pineapple</text>
  <text x="64" y="548" font-family="system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="13" font-weight="600" fill="#059669">Fresh Fruits • 100% Tree-Ripened & Sweet</text>
  
  <g transform="translate(480, 508)">
    <circle cx="20" cy="18" r="18" fill="#ecfdf5" />
    <path d="M14 18l4 4 8-8" fill="none" stroke="#059669" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
  </g>
</svg>